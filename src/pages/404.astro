---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title='Page Not Found' description='This page could not be found.'>
    <section class='not-found'>
        <p class='not-found-code'>404</p>
        <h1>Page not found</h1>
        <pre>
      .   -^^-      +                  .       *
    *    /    \        ----------------------------
         |____|       ( sorry, this link is broken )
        /      \    O  ----------------------------
       /        \ o                        *       .
  +   /__________\       +        .
     /            \    .                        +
     --------------                 *
      0 L/ -^ \ _A        *              .       +
        </pre>
        <p class='not-found-message'>
            The page you're looking for doesn't exist or may have moved.
        </p>
        <a class='not-found-link' href='/'>← Back to home</a>
    </section>
</BaseLayout>

<style>
    .not-found {
        padding-block: 2rem;
        max-width: 40rem;
    }

    .not-found-code {
        margin: 0 0 0 0.25rem;
        font-size: 0.95rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        color: var(--accent);
    }

    h1 {
        margin: 0 0 0.75rem;
    }

    .not-found-message {
        margin: 0 0 1.75rem;
        color: var(--muted);
    }

    .not-found-link {
        font-weight: 500;
    }
</style>