---

const links = [
  { label: 'About', href: '/' },
  { label: 'Activities', href: '/activities' }
];

const raw = Astro.url.pathname;
const current = raw !== '/' && raw.endsWith('/') ? raw.slice(0,-1) : raw;

function isActive(href: string) {
    if (href === '/') return current === '/';
    return current === href || current.startsWith(href + '/');
}
---

<header class='site-header'>
  <nav class='site-nav container' aria-label='Primary'>
    <a class='brand' href='/'>
      <span class='brand-name'>Hyunho Bae</span>
    </a>

    <ul class='nav-links'>
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={['nav-link', {active: isActive(link.href)}]}
              aria-current={isActive(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
    .site-header {
        border-bottom: 1px solid var(--border);
        background-color: var(--bg);
    }

    .site-nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        padding-block: 1rem;
    }

    .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--text);
        text-decoration: none;
    }

    .brand-name {
        font-size: 0.98rem;
        font-weight: 600;
        letter-spacing: -0.01em;
        white-space: nowrap;
    }

    .nav-links {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 1.35rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .nav-link {
        display: inline-flex;
        align-items: center;
        gap: 0.2rem;
        color: var(--muted);
        font-size: 0.9rem;
        font-weight: 500;
        text-decoration: none;
        transition: color 0.15s ease;
    }

    .nav-link:hover {
        color: var(--accent);
        text-decoration: none;
    }

    .nav-link.active {
        color: var(--text);
    }

    @media (max-width: 34rem) {
        .site-nav {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.85rem;
        }

        .nav-links {
            gap: 0.75rem 1.1rem;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .nav-link {
            transition: none;
        }
    }
</style>